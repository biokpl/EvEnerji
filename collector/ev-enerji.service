[Unit]
Description=Ev Enerji toplayici (Togg sarj + ev tuketimi)
After=network-online.target
Wants=network-online.target

[Service]
User=grid
WorkingDirectory=/home/grid/evenerji/collector
ExecStart=/home/grid/evenerji/venv/bin/python collector.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
